; PROJECT ASSASSIN — Godot 4 project
config_version=5

[application]
config/name="PROJECT ASSASSIN"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")

[autoload]
Campaign="*res://scripts/core/campaign_state.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

[physics]
3d/default_gravity=9.8

[input]
move_forward={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":87)]}
move_back={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":83)]}
move_left={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":65)]}
move_right={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":68)]}
sprint={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194325)]}
crouch={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":67)]}
interact={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":69)]}
release_mouse={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194305)]}
save_game={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194336)]}
load_game={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194340)]}

equip_primary={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":49)]}
equip_secondary={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":50)]}
use_equipment={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":81)]}
aim={"deadzone":0.2,"events":[Object(InputEventMouseButton,"button_index":2)]}
fire={"deadzone":0.2,"events":[Object(InputEventMouseButton,"button_index":1)]}
instinct={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194326,"location":1)]}
