class_name StationMaterials
extends RefCounted
## Shared authored material finishes for the fictional Tung Chung station/train.
## Textures are original deterministic PNGs generated by tools/generate_tung_chung_textures.py.
const TILE := preload("res://assets/procedural/tung_chung_tile.png")
const TERRAZZO := preload("res://assets/procedural/tung_chung_terrazzo.png")
const BRUSHED := preload("res://assets/procedural/tung_chung_brushed_metal.png")
const CONCRETE := preload("res://assets/procedural/tung_chung_concrete.png")
const RUBBER := preload("res://assets/procedural/tung_chung_rubber.png")
const FABRIC := preload("res://assets/procedural/tung_chung_train_fabric.png")
const WOOD := preload("res://assets/procedural/tung_chung_warm_wood.png")

static var material_cache: Dictionary = {}
static var box_cache: Dictionary = {}

static func box_mesh(size: Vector3) -> BoxMesh:
 if not box_cache.has(size):
  var mesh := BoxMesh.new()
  mesh.size = size
  box_cache[size] = mesh
 return box_cache[size]

static func material(color: Color, finish: String = "plain") -> StandardMaterial3D:
 var key := finish + ":" + color.to_html(true)
 if material_cache.has(key):
  return material_cache[key]
 var result := StandardMaterial3D.new()
 result.albedo_color = color
 match finish:
  "terrazzo":
   result.albedo_texture = TERRAZZO
   result.roughness = 0.38
   result.metallic = 0.04
   result.uv1_scale = Vector3(4.0, 4.0, 1.0)
  "tile":
   result.albedo_texture = TILE
   result.roughness = 0.3
   result.metallic = 0.06
   result.uv1_scale = Vector3(10.0, 10.0, 1.0)
  "concrete":
   result.albedo_texture = CONCRETE
   result.roughness = 0.88
   result.uv1_scale = Vector3(5.0, 5.0, 1.0)
  "brushed_metal":
   result.albedo_texture = BRUSHED
   result.roughness = 0.34
   result.metallic = 0.72
   result.uv1_scale = Vector3(5.0, 3.0, 1.0)
  "painted_metal":
   result.albedo_texture = BRUSHED
   result.roughness = 0.52
   result.metallic = 0.24
   result.uv1_scale = Vector3(4.0, 4.0, 1.0)
  "rubber":
   result.albedo_texture = RUBBER
   result.roughness = 0.94
   result.uv1_scale = Vector3(4.0, 4.0, 1.0)
  "fabric":
   result.albedo_texture = FABRIC
   result.roughness = 0.96
   result.uv1_scale = Vector3(2.5, 2.5, 1.0)
  "wood":
   result.albedo_texture = WOOD
   result.roughness = 0.58
   result.uv1_scale = Vector3(3.0, 2.0, 1.0)
  "glass":
   result.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
   result.roughness = 0.16
   result.metallic = 0.26
   result.cull_mode = BaseMaterial3D.CULL_DISABLED
  "emissive":
   result.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
   result.emission_enabled = true
   result.emission = color
   result.emission_energy_multiplier = 1.2
   result.roughness = 0.8
  _:
   result.roughness = 0.78
 material_cache[key] = result
 return result
